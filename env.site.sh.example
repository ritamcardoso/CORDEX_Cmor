#!/bin/bash
#
# env.site.sh.example — copy to env.site.sh and fill in (README.md §4).
# Per-experiment settings live in experiments/<name>/ instead.
#----------------------------------------------------------------

#
#--- Slurm settings, passed to every job by submit.sh ("" = don't pass)
# submit.sh adds these to every job's sbatch call; a line missing here
# uses the default shown, and your own command-line flags win.
#
JOB_QOS="nf"                      # queue (ECMWF: nf = fractional/serial)
JOB_NODES="1"                     # nodes per job
JOB_NTASKS="1"                    # tasks per job (the programs are serial)
JOB_HINT="nomultithread"          # one task per physical core
JOB_ACCOUNT=""                    # your ECMWF project account
JOB_MAIL_TYPE="ALL"               # NONE, BEGIN, END, FAIL, ALL, ...
JOB_MAIL_USER=""                  # e.g. "you@example.org"
JOB_CHDIR=""                      # where job logs land, e.g. "$SCRATCH/Analysis"

#
#--- Paths ------------------------------------------------------
# Where the Fortran sources and the per-variable namelist headers are.
#
PROG_DIR=${ROOT_DIR}/f90_src
HEADER_DIR=${ROOT_DIR}/header

#
#--- Experiment: folder name in experiments/ (override: EXPERIMENT=<name> ./submit.sh ...)
# Name of the folder in experiments/ to use (its .sh file and ini files).
# A running chain keeps the experiment it was started with.
#
EXPERIMENT="${EXPERIMENT:-fpsurb}"

#
#--- Archive step: on/off, modules and remote host --------------
# ARCHIVE="on" submits an archive job (ECFS + scp) after each processing job;
# "off" leaves the output in each grid's OUTPUT_DIR.
#
ARCHIVE="off"                     # "on": submit an archive (ECFS + scp) job after each processing job
CP_MODULES="prgenv/intel netcdf4 hpcx-openmpi jasper/2.0.14 hdf5/1.12.2 nco/4.9.7 python3"

REMOTE_HOST="wrf@nimbus.degge.fc.ul.pt"
COPY_ATTEMPTS=3                   # scp attempts per variable before the archive job gives up
COPY_WAIT=300                     # seconds to wait between attempts

#
#--- Repacking --------------------------------------------------
# "on": every file is repacked with tools/ncrepack-cordex right after it is
# written (CORDEX archive layout), so no repacking is needed afterwards.
# Needs h5repack, h5stat and h5dump, from the HDF5 module in MODULES.
# "off": files are left as the programs write them.
#
REPACK="on"

# Modules the aggregation job (run_aggregate.sh) loads when NCO is not already
# on the PATH after MODULES.
AGG_MODULES="nco"

#
#--- Modules: versions and the list every job loads -------------
# The single place to change modules: every job (run_analysis.sh,
# run_out_generic.sh, run_cp_generic.sh) loads MODULES from here.
#
intel_v="2023.2"
hdf5_v="1.14.3"
netcdf_v="4.9.2"
hpx_v="2.17"
# The library folders are /usr/local/apps/<lib>/<version>/INTEL/<x>/HPCX/<y>;
# <x> and <y> can be written differently from the module versions above
# (look with: ls /usr/local/apps/netcdf4-parallel/${netcdf_v}/INTEL/*/HPCX/).
intel_dir_v="${intel_v}"
hpx_dir_v="${hpx_v}"

MODULES="prgenv/intel intel/${intel_v} hpcx-openmpi/${hpx_v} netcdf4-parallel/${netcdf_v} hdf5-parallel/${hdf5_v}"
# shellcheck disable=SC2086
[ -n "${MODULES}" ] && module load ${MODULES}

# IDL-FCUL only: a personal file that loads the modules instead of MODULES
# above. Other users don't have it — leave it commented out.
#source ~/.bash_compile_wrf

#
#--- Compiler and libraries -------------------------------------
# Fortran compiler, flags and NetCDF/HDF5 paths used to build
# each RCM_* program before it runs (versions from the Modules section).
#

FC="ifort"
FFLAGS="-traceback -check all"
MOD_NAME="datvar_s"
SUB_NAME="shared_subs_v2"

# NetCDF and HDF5 folders: $NETCDF / $HDF5 if already set (e.g. by
# ~/.bash_compile_wrf), otherwise built from the versions above.
NETCDF_DIR="${NETCDF:-/usr/local/apps/netcdf4-parallel/${netcdf_v}/INTEL/${intel_dir_v}/HPCX/${hpx_dir_v}}"
HDF5_DIR="${HDF5:-/usr/local/apps/hdf5-parallel/${hdf5_v}/INTEL/${intel_dir_v}/HPCX/${hpx_dir_v}}"
if [ ! -f "${NETCDF_DIR}/include/netcdf.mod" ]; then
  echo "WARNING (env.site.sh): no netcdf.mod in ${NETCDF_DIR}/include — the programs won't compile." \
       "Set intel_dir_v / hpx_dir_v (folders: ls /usr/local/apps/netcdf4-parallel/${netcdf_v}/INTEL/*/HPCX/)." >&2
fi

NC_INC="-I${NETCDF_DIR}/include"
NC_LIB="-L${NETCDF_DIR}/lib64 -lnetcdff -lnetcdf"
HDF_LIB="-L${HDF5_DIR}/lib64 -lhdf5hl_fortran -lhdf5_hl -lhdf5_fortran -lhdf5"
OTHER_LIBS="-lm -lz"

ALL_LIBS="$NC_INC $NC_LIB $HDF_LIB $OTHER_LIBS"

# The modules don't put the NetCDF/HDF5 lib64 folders on LD_LIBRARY_PATH;
# without this the programs stop with "error while loading shared
# libraries: libhdf5hl_fortran.so...".
export LD_LIBRARY_PATH="${HDF5_DIR}/lib64:${NETCDF_DIR}/lib64:${LD_LIBRARY_PATH:-}"

